<Project Sdk="Microsoft.NET.Sdk">
  <!-- The bus company's own messages, generated from protocol/transport.proto: shared by the side game and the
       C# clients, which show its view and send its commands. -->
  <PropertyGroup>
    <RootNamespace>ToyCity.Transport.Wire</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../protocol/transport.proto" GrpcServices="None" Link="transport.proto" />
  </ItemGroup>
</Project>
