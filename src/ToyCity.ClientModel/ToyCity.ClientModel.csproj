<Project Sdk="Microsoft.NET.Sdk">
  <!-- What a C# client knows about the city: its mirror of the state, the connection, and naming rules shared
       with the server. No engine types, so the Godot client and tests both use it. -->
  <PropertyGroup>
    <RootNamespace>ToyCity.ClientModel</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ToyCity.Wire/ToyCity.Wire.csproj" />
    <ProjectReference Include="../ToyCity.Transport.Wire/ToyCity.Transport.Wire.csproj" />
    <ProjectReference Include="../ToyCity.Emergency.Wire/ToyCity.Emergency.Wire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Path grading is shared word for word with the sim, so previews price exactly what the server builds. -->
    <Compile Include="../ToyCity.Sim/PathGrade.cs" Link="Shared/PathGrade.cs" />
  </ItemGroup>
</Project>
