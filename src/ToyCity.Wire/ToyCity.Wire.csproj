<Project Sdk="Microsoft.NET.Sdk">
  <!-- The city's wire messages, generated from protocol/toycity.proto: shared by the server and every C# client. -->
  <PropertyGroup>
    <RootNamespace>ToyCity.Protocol.V0</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../protocol/toycity.proto" GrpcServices="None" Link="toycity.proto" />
  </ItemGroup>
</Project>
