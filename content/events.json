    {
      "id": "news-jobs",
      "kind": "news",
      "weight": 5,
      "cooldownMonths": 12,
      "minPopulation": 300,
      "trigger": [
        { "id": "u", "op": "measure.stat", "stat": "unemployed" },
        { "id": "l", "op": "measure.stat", "stat": "laborForce" },
        { "op": "test.gt", "in": [{ "op": "math.mul", "in": ["u", 10] }, "l"] }
      ]
    }
  ]
