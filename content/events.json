{
  "version": 1,
  "notes": "Event templates for the event director. Petitions ask for something and resolve on their own when the goal graph turns non-zero (fulfilled) or the deadline passes (ignored). Deals wait for the mayor to accept or decline; no answer by the deadline counts as declined. News items are headlines only. 'locate' picks where the event happens: home, shop, factory or road, with the lowest or highest value of a layer. Graphs use the rule-graph format of ordinances.json; measure.here reads a layer at the event's location. Outcome graphs run once when the event resolves (act.grant, act.mood and act.unlock happen then); if durationMonths is set, their modifiers and money keep running monthly for that long. All words come from voice.json, keyed by the event id.",
  "director": { "chancePercent": 40, "minMonthsBetween": 2, "maxOpen": 3, "newsChancePercent": 30 },
  "events": [
    {
      "id": "petition-park",
      "kind": "petition",
      "weight": 10,
      "cooldownMonths": 18,
      "minPopulation": 300,
      "locate": "home.lowest:parks",
      "deadlineMonths": 9,
      "trigger": [ { "id": "p", "op": "measure.here", "layer": "parks" }, { "op": "test.lt", "in": ["p", 20] } ],
      "goal": [ { "id": "p", "op": "measure.here", "layer": "parks", "label": "Park coverage here (%)" }, { "op": "test.ge", "in": ["p", 35] } ],
      "goalText": "Park coverage of at least 35% at their homes.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [8] }, { "op": "act.grant", "in": [500], "label": "Neighbours chip in" } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-6] } ] }
    },
    {
      "id": "petition-police",
      "kind": "petition",
      "weight": 8,
      "cooldownMonths": 24,
      "minPopulation": 800,
      "locate": "home.lowest:police",
      "deadlineMonths": 12,
      "trigger": [ { "id": "p", "op": "measure.here", "layer": "police" }, { "op": "test.lt", "in": ["p", 15] } ],
      "goal": [ { "id": "p", "op": "measure.here", "layer": "police", "label": "Police coverage here (%)" }, { "op": "test.ge", "in": ["p", 20] } ],
      "goalText": "Police coverage of at least 20% at their homes.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [8] } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-8] } ] }
    },
    {
      "id": "petition-school",
      "kind": "petition",
      "weight": 8,
      "cooldownMonths": 24,
      "minPopulation": 1500,
      "locate": "home.lowest:education",
      "deadlineMonths": 12,
      "trigger": [ { "id": "p", "op": "measure.here", "layer": "education" }, { "op": "test.lt", "in": ["p", 15] } ],
      "goal": [ { "id": "p", "op": "measure.here", "layer": "education", "label": "School coverage here (%)" }, { "op": "test.ge", "in": ["p", 20] } ],
      "goalText": "School coverage of at least 20% at their homes.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [10] } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-8] } ] }
    },
    {
      "id": "petition-clinic",
      "kind": "petition",
      "weight": 6,
      "cooldownMonths": 24,
      "minPopulation": 1000,
      "locate": "home.lowest:health",
      "deadlineMonths": 12,
      "trigger": [ { "id": "p", "op": "measure.here", "layer": "health" }, { "op": "test.lt", "in": ["p", 15] } ],
      "goal": [ { "id": "p", "op": "measure.here", "layer": "health", "label": "Health coverage here (%)" }, { "op": "test.ge", "in": ["p", 20] } ],
      "goalText": "Health coverage of at least 20% at their homes.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [8] } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-6] } ] }
    },
    {
      "id": "petition-taxes",
      "kind": "petition",
      "weight": 12,
      "cooldownMonths": 12,
      "minPopulation": 200,
      "locate": "home.lowest:desR",
      "deadlineMonths": 6,
      "trigger": [ { "id": "t", "op": "measure.stat", "stat": "taxR" }, { "op": "test.gt", "in": ["t", 100] } ],
      "goal": [ { "id": "t", "op": "measure.stat", "stat": "taxR", "label": "Average residential tax (tenths of %)" }, { "op": "test.le", "in": ["t", 90] } ],
      "goalText": "Residential taxes back to 9% or less.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [6] } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-10] } ] }
    },
    {
      "id": "petition-traffic",
      "kind": "petition",
      "weight": 8,
      "cooldownMonths": 18,
      "minPopulation": 500,
      "locate": "road.highest:traffic",
      "deadlineMonths": 9,
      "trigger": [ { "id": "t", "op": "measure.here", "layer": "traffic" }, { "op": "test.gt", "in": ["t", 128] } ],
      "goal": [ { "id": "t", "op": "measure.here", "layer": "traffic", "label": "Traffic here (128 = at capacity)" }, { "op": "test.lt", "in": ["t", 100] } ],
      "goalText": "Traffic on that road below 80% of capacity.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [8] } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-6] } ] }
    },
    {
      "id": "petition-recycling",
      "kind": "petition",
      "weight": 6,
      "cooldownMonths": 36,
      "minPopulation": 2000,
      "locate": "home.lowest:landValue",
      "deadlineMonths": 6,
      "trigger": [ { "id": "on", "op": "measure.ordinance", "ordinance": "recycling" }, { "op": "test.not", "in": ["on"] } ],
      "goal": [ { "op": "measure.ordinance", "ordinance": "recycling", "label": "Recycling Program enacted" } ],
      "goalText": "Enact the Recycling Program.",
      "onFulfilled": { "nodes": [ { "op": "act.mood", "in": [6] } ] },
      "onIgnored": { "nodes": [ { "op": "act.mood", "in": [-4] } ] }
    },
    {
      "id": "deal-casino",
      "kind": "deal",
      "weight": 5,
      "cooldownMonths": 60,
      "minPopulation": 1500,
      "deadlineMonths": 3,
      "trigger": [ { "id": "t", "op": "measure.type", "type": "casino" }, { "op": "test.eq", "in": ["t", 0] } ],
      "onAccept": { "nodes": [ { "op": "act.unlock", "type": "casino", "in": [1] }, { "op": "act.grant", "in": [2000], "label": "Casino signing bonus" }, { "op": "act.mood", "in": [-4] } ] },
      "onDecline": { "nodes": [ { "op": "act.mood", "in": [2] } ] }
    },
    {
      "id": "deal-toxic-dump",
      "kind": "deal",
      "weight": 4,
      "cooldownMonths": 60,
      "minPopulation": 800,
      "deadlineMonths": 3,
      "trigger": [ { "id": "t", "op": "measure.type", "type": "toxic-dump" }, { "op": "test.eq", "in": ["t", 0] } ],
      "onAccept": { "nodes": [ { "op": "act.unlock", "type": "toxic-dump", "in": [1] }, { "op": "act.grant", "in": [5000], "label": "Waste contract advance" }, { "op": "act.mood", "in": [-10] } ] },
      "onDecline": { "nodes": [ { "op": "act.mood", "in": [3] } ] }
    },
    {
      "id": "deal-pickle-plant",
      "kind": "deal",
      "weight": 5,
      "cooldownMonths": 60,
      "minPopulation": 1000,
      "deadlineMonths": 3,
      "trigger": [ { "id": "t", "op": "measure.type", "type": "pickle-plant" }, { "op": "test.eq", "in": ["t", 0] } ],
      "durationMonths": 12,
      "onAccept": { "durationMonths": 12, "nodes": [ { "op": "act.unlock", "type": "pickle-plant", "in": [1] }, { "op": "act.modifier", "key": "demand.I", "in": [8] } ] },
      "onDecline": { "nodes": [] }
    },
    {
      "id": "deal-billboards",
      "kind": "deal",
      "weight": 6,
      "cooldownMonths": 36,
      "minPopulation": 600,
      "deadlineMonths": 2,
      "trigger": [ { "op": "const", "value": 1 } ],
      "onAccept": { "durationMonths": 12, "nodes": [ { "op": "act.income", "in": [300], "label": "Billboard rent" }, { "op": "act.modifier", "key": "desirability.R", "in": [-3] } ] },
      "onDecline": { "nodes": [ { "op": "act.mood", "in": [1] } ] }
    },
    {
      "id": "deal-sports-team",
      "kind": "deal",
      "weight": 4,
      "cooldownMonths": 48,
      "minPopulation": 3000,
      "deadlineMonths": 3,
      "trigger": [ { "op": "const", "value": 1 } ],
      "onAccept": { "durationMonths": 12, "nodes": [ { "op": "act.expense", "in": [400], "label": "Team subsidy" }, { "op": "act.modifier", "key": "attraction", "in": [4] }, { "op": "act.modifier", "key": "demand.C", "in": [5] }, { "op": "act.mood", "in": [5] } ] },
      "onDecline": { "nodes": [ { "op": "act.mood", "in": [-2] } ] }
    },
    { "id": "news-pie", "kind": "news", "weight": 3, "cooldownMonths": 24, "minPopulation": 100, "trigger": [ { "op": "const", "value": 1 } ] },
    { "id": "news-weather", "kind": "news", "weight": 4, "cooldownMonths": 6, "minPopulation": 0, "trigger": [ { "op": "const", "value": 1 } ] },
    { "id": "news-cat", "kind": "news", "weight": 2, "cooldownMonths": 36, "minPopulation": 500, "trigger": [ { "op": "const", "value": 1 } ] },
    { "id": "news-pothole", "kind": "news", "weight": 3, "cooldownMonths": 12, "minPopulation": 300, "locate": "road.highest:traffic", "trigger": [ { "op": "const", "value": 1 } ] },
    {
      "id": "news-smog",
      "kind": "news",
      "weight": 6,
      "cooldownMonths": 12,
      "minPopulation": 300,
      "locate": "home.highest:pollution",
      "trigger": [ { "id": "p", "op": "measure.here", "layer": "pollution" }, { "op": "test.gt", "in": ["p", 40] } ]
